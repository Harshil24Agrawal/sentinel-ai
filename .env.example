# SentinelAI configuration. Copy to .env (git-ignored). Every key is optional;
# the values below are the defaults. Never commit real credentials.

# Files
LOG_PATH=data/logs/app.log
DB_PATH=data/sentinel.db
DRYRUN_PATH=data/notifications_dryrun.jsonl

# Pipeline
TICK_SECONDS=1
WINDOW_SECONDS=60
BASELINE_HISTORY_SAMPLES=900
WARMUP_SAMPLES=30
COLLECTOR_FROM_START=false

# Detection
MIN_VOLUME=30
OPEN_Z=3.0
RESOLVE_Z=1.5
ABS_FLOOR_ERROR=0.02
PERSIST_TICKS=5
RESOLVE_TICKS=30
COOLDOWN_SECONDS=60
CORRELATION_WINDOW_SECONDS=180
# Silence looks at the last N seconds; 60 = the whole window (spec, ~48s to fire), 20 = ~16s.
SILENCE_LOOKBACK_SECONDS=20

# Redaction (list values are JSON)
# PHI_KEYS=["ssn","member_id","patient_name","name","dob","email","phone","address","mrn"]

# AWS notifier (dry-run unless AWS_ENABLED=true and the startup self-check passes: identity,
# then the CloudWatch log group/stream, then the SNS topic -- see GET /api/health.aws_checks)
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_PROFILE=
CW_LOG_GROUP=/sentinel-ai/incidents
CW_LOG_STREAM=demo
SNS_TOPIC_ARN=
# Linked from SNS notification bodies; set to wherever the dashboard is actually reachable.
DASHBOARD_URL=http://localhost:8000
# AWS credentials come from AWS_PROFILE above, or (if unset) the standard AWS chain
# (env vars, default profile, role). Never put access keys in this file; use a profile instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional LLM explainer: none | anthropic | openai | azure_openai | bedrock
LLM_PROVIDER=none
LLM_MODEL=
# ANTHROPIC_API_KEY=

# API
# CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# FRONTEND_DIR=frontend   # served at http://localhost:8000/ when it contains index.html

# Built-in synthetic traffic
GENERATOR_ENABLED=true
# GENERATOR_SEED=42
