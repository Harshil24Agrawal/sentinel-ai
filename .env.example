# SentinelAI configuration. Copy to .env (git-ignored). Every key is optional;
# the values below are the defaults. Never commit real credentials.

# Files
LOG_PATH=data/logs/app.log
DB_PATH=data/sentinel.db
DRYRUN_PATH=data/notifications_dryrun.jsonl

# Pipeline
TICK_SECONDS=1
WINDOW_SECONDS=60
BASELINE_HISTORY_SAMPLES=900
WARMUP_SAMPLES=30
COLLECTOR_FROM_START=false

# Detection
MIN_VOLUME=30
OPEN_Z=3.0
RESOLVE_Z=1.5
ABS_FLOOR_ERROR=0.02
PERSIST_TICKS=5
RESOLVE_TICKS=30
COOLDOWN_SECONDS=60
CORRELATION_WINDOW_SECONDS=180
# Silence looks at the last N seconds; 60 = the whole window (spec). 20 detects sooner.
SILENCE_LOOKBACK_SECONDS=60

# Redaction (list values are JSON)
# PHI_KEYS=["ssn","member_id","patient_name","name","dob","email","phone","address","mrn"]

# AWS notifier (dry-run unless AWS_ENABLED=true and credentials are available)
AWS_ENABLED=false
AWS_REGION=us-east-1
CW_LOG_GROUP=/sentinel-ai/incidents
CW_LOG_STREAM=demo
SNS_TOPIC_ARN=
# AWS credentials come from the standard AWS chain (env vars, profile, role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional LLM explainer: none | anthropic | openai | azure_openai | bedrock
LLM_PROVIDER=none
LLM_MODEL=
# ANTHROPIC_API_KEY=

# Built-in synthetic traffic
GENERATOR_ENABLED=true
# GENERATOR_SEED=42
